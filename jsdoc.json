{
  "source": {
    "include": [
      "src"
    ],
    "includePattern": "\\.(jsx|js)$",
    "excludePattern": "(node_modules|docs|build|dist)"
  },
  "tags": {
    "allowUnknownTags": true
  },  
  "plugins": ["plugins/markdown", "better-docs/component", "better-docs/category"],
  "templates": {
    "cleverLinks": true,
    "monospaceLinks": true,
    "default": {
      "outputSourceFiles": true
    }
  },
  "opts": {
    "recurse": true,
    "destination": "./docs",
    "template": "node_modules/better-docs",
    "readme": "./README.md"
  }  
}