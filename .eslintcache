ects\\Sensie\\src\\components\\index.js",[],"C:\\Projects\\Sensie\\src\\constants\\theme.js",[],"C:\\Projects\\Sensie\\src\\landing\\containers\\App.js",[],"C:\\Projects\\Sensie\\src\\dashboard\\components\\Globals.js",[],"C:\\Projects\\Sensie\\src\\dashboard\\constants\\routes.js",[],"C:\\Projects\\Sensie\\src\\dashboard\\routes\\dashboard.routes.js",[],"C:\\Projects\\Sensie\\src\\constants\\routes.js",[],"C:\\Projects\\Sensie\\src\\landing\\routes\\landing.routes.js",[],"C:\\Projects\\Sensie\\src\\routes\\App.jsx",[],"C:\\Projects\\Sensie\\src\\reportWebVitals.js",[],"C:\\Projects\\Sensie\\src\\dashboard\\containers\\Client.js",[],"C:\\Projects\\Sensie\\src\\dashboard\\containers\\Team.js",[],"C:\\Projects\\Sensie\\src\\dashboard\\constants\\theme.js",[],[],"C:\\Projects\\Sensie\\src\\dashboard\\components\\Icon.js",[],"C:\\Projects\\Sensie\\src\\dashboard\\components\\Layout\\index.js",["175"],"/* eslint-disable react/prop-types */\r\n// react\r\nimport React, { useState } from 'react'\r\nimport { NavLink } from 'react-router-dom'\r\n// material-ui\r\nimport clsx from 'clsx'\r\nimport { makeStyles } from '@material-ui/core/styles'\r\nimport Drawer from '@material-ui/core/Drawer'\r\nimport AppBar from '@material-ui/core/AppBar'\r\nimport Toolbar from '@material-ui/core/Toolbar'\r\nimport List from '@material-ui/core/List'\r\nimport CssBaseline from '@material-ui/core/CssBaseline'\r\nimport Typography from '@material-ui/core/Typography'\r\nimport Divider from '@material-ui/core/Divider'\r\nimport IconButton from '@material-ui/core/IconButton'\r\nimport Badge from '@material-ui/core/Badge'\r\nimport ListItem from '@material-ui/core/ListItem'\r\nimport ListItemIcon from '@material-ui/core/ListItemIcon'\r\nimport ListItemText from '@material-ui/core/ListItemText'\r\n// components\r\nimport Icon from '../Icon'\r\nimport ImageAvatar from '../ImageAvatar'\r\n// constants-routes\r\nimport DASHBOARD_ROUTES from '../../constants/routes'\r\nimport { COLORS } from '../../constants/theme'\r\n// styles\r\nimport './styles.scss'\r\n\r\n// const-routes\r\nconst { home, client, team } = DASHBOARD_ROUTES\r\n// const-colors\r\nconst { backgroundColor1, actionColor1, fontColor1, fontColor2 } = COLORS\r\n// const-sizes\r\nconst drawerWidth = 240\r\n// const-items\r\nconst listItems = [\r\n  {\r\n    title: 'Home',\r\n    icon: 'home-outline',\r\n    link: home\r\n  },\r\n  {\r\n    title: 'Client Dashboard',\r\n    icon: 'layout-outline',\r\n    link: client\r\n  },\r\n  {\r\n    title: 'Team',\r\n    icon: 'people-outline',\r\n    link: team\r\n  }\r\n]\r\nconst urlTest = 'https://www.hardwoodandhollywood.com/pop-culture-spin/wp-content/uploads/sites/7/2015/12/richard.png'\r\n\r\nconst Layout = ({ children }) => {\r\n  // hooks\r\n  const [open, setOpen] = useState(false)\r\n  const classes = useStyles()\r\n\r\n  // handle functions\r\n  const handleDrawerOpen = () => {\r\n    setOpen(!open)\r\n  }\r\n\r\n  // render functions\r\n  const renderListItems = () => {\r\n    return listItems.map((item, index) =>\r\n      <NavLink\r\n        to={item.link}\r\n        key={index}\r\n        className=\"LayoutLinkTo\"\r\n        activeClassName='LayoutLinkToSelected'>\r\n        <ListItem className='LayoutLinkToListItem'>\r\n            <ListItemIcon className=\"LayoutLinkToIcon\"><Icon name={item.icon} size=\"md\" color={fontColor1} /></ListItemIcon>\r\n            <div className=\"LayoutLinkToTextContainer\">\r\n              <ListItemText className=\"LayoutLinkToText\" primary={item.title} />\r\n            </div>\r\n        </ListItem>\r\n      </NavLink>\r\n    )\r\n  }\r\n\r\n  const renderAvatar = () => {\r\n    return <ListItem className='LayoutAvatarListItem'>\r\n      <ListItemIcon className=\"LayoutAvatarImgContainer\">\r\n        <ImageAvatar url={urlTest} size=\"small\" />\r\n      </ListItemIcon>\r\n      <div className=\"LayoutAvatarTextContainer\">\r\n        <ListItemText className=\"LayoutAvatarText\" primary=\"Richard Hendricks\" />\r\n        <div className=\"LayoutAvatarSubTextContainer\">\r\n          <span className=\"LayoutAvatarSubText\">Couch</span>\r\n          <Icon name=\"arrow-ios-downward-outline\" size=\"s\" color={fontColor2} />\r\n        </div>\r\n      </div>\r\n    </ListItem>\r\n  }\r\n\r\n  return (\r\n    <div className=\"LayoutContainer\">\r\n      <CssBaseline />\r\n      <AppBar\r\n        position=\"fixed\"\r\n        className={clsx(classes.appBar, {\r\n          [classes.appBarShift]: open\r\n        })}\r\n      >\r\n        <Toolbar>\r\n          <IconButton\r\n            color=\"inherit\"\r\n            aria-label=\"open drawer\"\r\n            onClick={handleDrawerOpen}\r\n            edge=\"start\"\r\n            className={clsx(classes.menuButton, {\r\n              [classes.hide]: open\r\n            })}\r\n          >\r\n            <Icon name=\"menu-outline\" size=\"md\" color={fontColor1} />\r\n          </IconButton>\r\n          <div className=\"LayoutAppBarLeftIconsContainer\">\r\n            <Typography variant=\"h6\" noWrap>\r\n              Sensie\r\n            </Typography>\r\n            <div>\r\n              <IconButton aria-label=\"show notifications\" color=\"inherit\">\r\n                <Badge badgeContent={17} color=\"primary\">\r\n                  <Icon name=\"bell-outline\" size=\"md\" color={fontColor1} />\r\n                </Badge>\r\n              </IconButton>\r\n              <IconButton aria-label=\"show 17 new notifications\" color=\"inherit\">\r\n                <Icon name=\"log-out-outline\" size=\"md\" color={fontColor1} />\r\n              </IconButton>\r\n            </div>\r\n          </div>\r\n        </Toolbar>\r\n      </AppBar>\r\n      <Drawer\r\n        variant=\"permanent\"\r\n        className={clsx(classes.drawer, {\r\n          [classes.drawerOpen]: open,\r\n          [classes.drawerClose]: !open\r\n        })}\r\n        classes={{\r\n          paper: clsx({\r\n            [classes.drawerOpen]: open,\r\n            [classes.drawerClose]: !open\r\n          })\r\n        }}\r\n      >\r\n        <div className={classes.toolbar}>\r\n          <IconButton onClick={handleDrawerOpen}>\r\n            <Icon name=\"chevron-left-outline\" size=\"md\" color={fontColor1} />\r\n          </IconButton>\r\n        </div>\r\n        <Divider />\r\n        <List className=\"LayoutListContainer\">\r\n          <div>\r\n            {renderListItems()}\r\n          </div>\r\n          <div>\r\n            {renderAvatar()}\r\n          </div>\r\n        </List>\r\n      </Drawer>\r\n      <main className={classes.content}>\r\n        <div className={classes.toolbar} />\r\n        <div className=\"LayoutchildrenContainer\">\r\n          {children}\r\n        </div>\r\n      </main>\r\n    </div>\r\n  )\r\n}\r\n\r\n// styles\r\nconst useStyles = makeStyles((theme) => ({\r\n  appBar: {\r\n    backgroundColor: backgroundColor1,\r\n    zIndex: theme.zIndex.drawer + 1,\r\n    transition: theme.transitions.create(['width', 'margin'], {\r\n      easing: theme.transitions.easing.sharp,\r\n      duration: theme.transitions.duration.leavingScreen\r\n    })\r\n  },\r\n  appBarShift: {\r\n    marginLeft: drawerWidth,\r\n    width: `calc(100% - ${drawerWidth}px)`,\r\n    transition: theme.transitions.create(['width', 'margin'], {\r\n      easing: theme.transitions.easing.sharp,\r\n      duration: theme.transitions.duration.enteringScreen\r\n    })\r\n  },\r\n  menuButton: {\r\n    color: fontColor1,\r\n    marginRight: 36\r\n  },\r\n  hide: {\r\n    display: 'none'\r\n  },\r\n  drawer: {\r\n    width: drawerWidth,\r\n    flexShrink: 0,\r\n    whiteSpace: 'nowrap'\r\n  },\r\n  drawerOpen: {\r\n    backgroundColor: backgroundColor1,\r\n    color: fontColor1,\r\n    width: drawerWidth,\r\n    transition: theme.transitions.create('width', {\r\n      easing: theme.transitions.easing.sharp,\r\n      duration: theme.transitions.duration.enteringScreen\r\n    })\r\n  },\r\n  drawerClose: {\r\n    backgroundColor: backgroundColor1,\r\n    color: fontColor1,\r\n    transition: theme.transitions.create('width', {\r\n      easing: theme.transitions.easing.sharp,\r\n      duration: theme.transitions.duration.leavingScreen\r\n    }),\r\n    overflowX: 'hidden',\r\n    width: theme.spacing(7) + 1,\r\n    [theme.breakpoints.up('sm')]: {\r\n      width: theme.spacing(9) + 1\r\n    }\r\n  },\r\n  toolbar: {\r\n    color: fontColor1,\r\n    display: 'flex',\r\n    alignItems: 'center',\r\n    justifyContent: 'flex-end',\r\n    ...theme.mixins.toolbar\r\n  },\r\n  content: {\r\n    flexGrow: 1,\r\n    padding: theme.spacing(3)\r\n  }\r\n}))\r\n\r\nexport default Layout\r\n","C:\\Projects\\Sensie\\src\\dashboard\\components\\ImageAvatar.js",[],"C:\\Projects\\Sensie\\src\\dashboard\\components\\Header\\index.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\index.js",[],[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\routes\\App.jsx",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\landing\\constants\\routes.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\components\\Globals.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\containers\\Home\\index.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\components\\Header\\index.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\components\\index.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\constants\\routes.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\containers\\Client.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\containers\\Team.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\landing\\containers\\App.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\landing\\routes\\landing.routes.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\components\\Icon.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\components\\ClientFlow\\index.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\routes\\dashboard.routes.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\components\\Layout\\index.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\landing\\components\\Globals.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\constants\\routes.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\components\\NotFound404\\index.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\components\\ImageAvatar.js",[],"C:\\Users\\braian.vaylet\\Desktop\\Sensie\\sensie-web\\src\\dashboard\\constants\\theme.js",[],{"ruleId":"176","severity":2,"message":"177","line":32,"column":27,"nodeType":"178","messageId":"179","endLine":32,"endColumn":39},"no-unused-vars","'actionColor1' is assigned a value but never used.","Identifier","unusedVar"]